# ─────────────────────────────────────────────────────────────────────────
# Europharmacy DB — connection config.  COPY THIS FILE TO ".env" AND FILL IN.
# NEVER commit the real .env (it is gitignored). Keep it private.
#
# Recommended location for the real file: ~/.europharmacy/.env
# (works from any project). The skills also look for ./.env and
# $EUROPHARMACY_ENV.
# ─────────────────────────────────────────────────────────────────────────

# Database name — usually "Europharmacy" for this software.
EUROPHARMACY_DB_NAME=Europharmacy

# SQL Server login (SQL auth — Windows auth does not work across a workgroup).
# Use a READ-ONLY login if you can create one (see europharmacy-setup skill).
EUROPHARMACY_DB_USER=youruser
EUROPHARMACY_DB_PASSWORD=yourpassword

# The SQL Server listens on a custom STATIC port (NOT 1433). Find it with the
# europharmacy-setup skill. Format:  <address>,<port>   e.g.  100.90.10.5,25025
#
# Preferred: your server's TAILSCALE address (100.x.y.z or its MagicDNS name).
# Works from anywhere while the server is up, without exposing SQL to the net.
EUROPHARMACY_DB_SERVER=100.x.y.z,PORT

# Fallback: the server's LAN hostname (not IP — IPs drift with DHCP).
EUROPHARMACY_DB_SERVER_LAN=SERVER_HOSTNAME,PORT

# Full connection strings (CONNSTR = default route; CONNSTR_LAN = fallback).
EUROPHARMACY_DB_CONNSTR=Server=100.x.y.z,PORT;Database=Europharmacy;User ID=youruser;Password=yourpassword;TrustServerCertificate=True
EUROPHARMACY_DB_CONNSTR_LAN=Server=SERVER_HOSTNAME,PORT;Database=Europharmacy;User ID=youruser;Password=yourpassword;TrustServerCertificate=True
