# ─────────────────────────────────────────────────────────────────────────
# Europharmacy config.  COPY THIS FILE TO ".env" AND FILL IN.
# NEVER commit the real .env (it is gitignored). Keep it private.
#
# Recommended location for the real file: ~/.europharmacy/.env
# (works from any project). The skills/scripts also look for $EUROPHARMACY_ENV
# and any .env in the current directory or a parent.
#
# Save it as UTF-8 if you use Greek characters in any value.
# ─────────────────────────────────────────────────────────────────────────

# ── Report branding (all optional) ────────────────────────────────────────
# Shown in the footer of generated reports.
EUROPHARMACY_NAME=Φαρμακείο

# Logo for the report header. PDF, PNG or SVG. Relative paths resolve against
# the folder holding this .env.
#EUROPHARMACY_LOGO=assets/logo.pdf
# Many logos have wide empty margins. ZOOM enlarges the image inside a fixed
# box and the overflow is clipped, i.e. it crops the padding away. 1 = no crop;
# try 2.0-2.5 for a logo whose artwork fills only ~half the canvas.
#EUROPHARMACY_LOGO_ZOOM=1

# Match these to your logo. PRIMARY is the dark brand colour (header band,
# headings), ACCENT the bright one (charts, highlights), SECOND a complementary
# tone used for the parapharmaceuticals figures. If your logo has a solid
# background equal to PRIMARY, it blends seamlessly into the header band.
#EUROPHARMACY_COLOR_PRIMARY=#3f4a5a
#EUROPHARMACY_COLOR_ACCENT=#7fc9bd
#EUROPHARMACY_COLOR_SECOND=#d9a05b

# ── Database ─────────────────────────────────────────────────────────────
# Database name — usually "Europharmacy" for this software.
EUROPHARMACY_DB_NAME=Europharmacy

# SQL Server login (SQL auth — Windows auth does not work across a workgroup).
# Use a READ-ONLY login if you can create one (see europharmacy-setup skill).
EUROPHARMACY_DB_USER=youruser
EUROPHARMACY_DB_PASSWORD=yourpassword

# The SQL Server listens on a custom STATIC port (NOT 1433). Find it with the
# europharmacy-setup skill. Format:  <address>,<port>   e.g.  100.90.10.5,25025
#
# Preferred: your server's TAILSCALE address (100.x.y.z or its MagicDNS name).
# Works from anywhere while the server is up, without exposing SQL to the net.
EUROPHARMACY_DB_SERVER=100.x.y.z,PORT

# Fallback: the server's LAN hostname (not IP — IPs drift with DHCP).
EUROPHARMACY_DB_SERVER_LAN=SERVER_HOSTNAME,PORT

# Full connection strings (CONNSTR = default route; CONNSTR_LAN = fallback).
EUROPHARMACY_DB_CONNSTR=Server=100.x.y.z,PORT;Database=Europharmacy;User ID=youruser;Password=yourpassword;TrustServerCertificate=True
EUROPHARMACY_DB_CONNSTR_LAN=Server=SERVER_HOSTNAME,PORT;Database=Europharmacy;User ID=youruser;Password=yourpassword;TrustServerCertificate=True

# ── Email (optional — only needed for `weekly-report.ps1 -Email`) ─────────
# Gmail: enable 2-step verification, then create a 16-character App Password
# at https://myaccount.google.com/apppasswords . Use that here, NOT your real
# account password. It can be revoked at any time without changing your login.
EUROPHARMACY_SMTP_HOST=smtp.gmail.com
EUROPHARMACY_SMTP_PORT=587
EUROPHARMACY_SMTP_USER=you@example.com
EUROPHARMACY_SMTP_PASS=your16charapppassword
# Comma-separated recipients.
EUROPHARMACY_SMTP_TO=recipient@example.com
